{
    "name": "robertgdev/laravel-base-repository",
    "description": "A lightweight base repository for Laravel Eloquent models with full CRUD, bulk write, aggregate and soft-delete support, no Criteria overhead.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "repository",
        "repository-pattern",
        "base-repository"
    ],
    "authors": [
        {
            "name": "Robert Gdev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "RobertGDev\\BaseRepository\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RobertGDev\\BaseRepository\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
